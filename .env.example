# Copy to .env and fill in. Every value here has a working default except
# ANTHROPIC_API_KEY -- without it the service falls back to extractive answers.

# --- Generation ---------------------------------------------------------
# Optional. When unset, /query returns extractive answers stitched from the
# retrieved chunks instead of LLM-synthesised ones. Everything else still works.
ANTHROPIC_API_KEY=

RAG_LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max  -- "low" keeps answer latency down.
RAG_LLM_EFFORT=low
RAG_LLM_MAX_TOKENS=1024
# disabled (fastest; retrieval already did the reasoning) | adaptive
# "disabled" is only valid with effort low/medium/high.
RAG_LLM_THINKING=disabled

# --- Embeddings ---------------------------------------------------------
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# onnx_quantized (default, fast) | sentence_transformers (torch baseline)
RAG_EMBED_BACKEND=onnx_quantized
RAG_EMBED_BATCH_SIZE=64
RAG_EMBED_CACHE_SIZE=1024

# --- Vector store -------------------------------------------------------
RAG_CHROMA_PATH=./data/chroma
RAG_COLLECTION=documents
# HNSW index tuning. Higher ef_search = better recall, slower queries.
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCTION=200
RAG_HNSW_EF_SEARCH=64

# --- Chunking -----------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# For CSV/JSON: columns to treat as text. Empty = auto-detect the widest ones.
RAG_TEXT_COLUMNS=

# --- Retrieval / agent --------------------------------------------------
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_MMR_LAMBDA=0.5
# Max sub-queries the planner may decompose a question into.
RAG_MAX_SUBQUERIES=3

# --- Service ------------------------------------------------------------
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_LOG_LEVEL=INFO
